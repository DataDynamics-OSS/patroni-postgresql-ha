#!/usr/bin/env bash
# {{ ansible_managed }}
#
# Keepalived 헬스체크 — "이 클러스터의 HAProxy 인스턴스"만 확인합니다.
# 실패(0 이 아닌 종료)하면 Keepalived 가 priority 를 낮춰 VIP 를 다른 노드로 넘깁니다.
#
# ── 왜 이렇게 짰는가 (전부 실기에서 확인된 제약) ───────────────────────────────
#
# ① `pidof haproxy` 로 판단하면 안 된다
#    같은 노드에서 다른 용도의 HAProxy 를 별도 인스턴스로 띄우면(예: 애플리케이션
#    UI 용 LB) 그 프로세스까지 함께 잡힌다. 그러면 정작 이 클러스터의 HAProxy 가
#    죽어도 "살아 있다"고 오판해 VIP 가 넘어가지 않고 DB 페일오버가 무력화된다.
#
# ② PID 파일(/run/haproxy.pid)을 읽는 방식도 쓸 수 없다
#    SELinux Enforcing 에서 keepalived_t 는 haproxy_var_run_t 를 읽지 못한다.
#    그러면 '정상 노드까지 전부' 실패로 판정된다. 게다가 이 거부는 dontaudit 라
#    ausearch 에 남지 않아 원인 파악이 매우 어렵다.
#    (증상: 모든 노드 priority 가 똑같이 내려가 상대 순위가 그대로 유지되므로
#     겉보기엔 정상처럼 보이지만 실제 페일오버는 죽어 있다.)
#
# ③ Keepalived 는 스크립트를 '최소 환경'에서 실행한다
#    PATH 가 사실상 비어 있어 외부 명령을 이름만으로 부르면 찾지 못하고 실패한다.
#
# 그래서 keepalived_t 에 허용된 두 가지만 사용한다:
#   ⓐ 우리 설정파일로 뜬 haproxy 프로세스가 있는가  → 인스턴스 특정
#   ⓑ 실제로 쓰기(RW) 포트를 듣고 있는가            → 프로세스는 살아 있으나
#                                                     바인딩에 실패한 상태까지 차단
set -u
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

CFG="{{ haproxy_config_file }}"
PORT="{{ haproxy_primary_port }}"

# ⓐ 이 클러스터의 설정파일로 실행 중인 haproxy 인가
pgrep -f -- "-f ${CFG}" >/dev/null 2>&1 || exit 1

# ⓑ 실제로 RW 포트를 서빙 중인가
ss -lntH "sport = :${PORT}" 2>/dev/null | grep -q . || exit 1

exit 0
